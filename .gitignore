# ── FastF1 cache (can be 100s of MBs) ────────────────────────────────
cache/

# ── Results & outputs (regenerated by running main.py) ───────────────
results/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── OS junk ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml

# ── Data files (if you download raw CSVs locally) ────────────────────
data/*.csv
data/*.parquet
data/*.pkl